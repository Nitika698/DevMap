# ==========================================
# DevMap Backend Server Configuration
# ==========================================

PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/devmap?retryWrites=true&w=majority

# AI Service URL (Flask microservice)
AI_SERVICE_URL=http://127.0.0.1:5001

# Frontend Client Origin URL
CLIENT_URL=http://localhost:5173
